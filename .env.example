# Mind-Q V4.1 Environment Configuration
# نموذج إعدادات البيئة لنظام Mind-Q V4.1

# ======================================
# LLM API Configuration / إعدادات APIs للذكاء الاصطناعي
# ======================================

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-organization-id  # Optional

# Anthropic Configuration  
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google AI Configuration
GOOGLE_API_KEY=your-google-ai-api-key-here
GOOGLE_PROJECT_ID=your-google-project-id  # Optional

# ======================================
# Pipeline Configuration / إعدادات خط الأنابيب
# ======================================

# Default LLM Provider (openai, anthropic, google)
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini

# Arabic Language Features
ENABLE_ARABIC_REPORTS=true
ARABIC_BUSINESS_DOMAIN=logistics

# Cost Management
MAX_MONTHLY_LLM_COST=100.00  # USD
ENABLE_COST_TRACKING=true

# ======================================
# Data Processing Configuration / إعدادات معالجة البيانات
# ======================================

# Performance Settings
MAX_MEMORY_GB=8
ENABLE_POLARS_STREAMING=true
LARGE_DATASET_THRESHOLD=100000

# Quality Thresholds
MAX_MISSING_PERCENTAGE=20
MIN_CARDINALITY_RATIO=0.90
CORRELATION_THRESHOLD=0.98

# PII Protection
ENABLE_PII_MASKING=true
PHONE_DETECTION_PATTERNS=phone,mobile,msisdn,whatsapp
EMAIL_DETECTION_PATTERNS=email,mail,e_mail

# ======================================
# Database Configuration / إعدادات قاعدة البيانات
# ======================================

# DuckDB Settings
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4

# Output Locations
ARTIFACTS_PATH=./artifacts
EXPORTS_PATH=./artifacts/exports
TEMP_PATH=./artifacts/temp
MINDQ_KNIME_MODE=prompt

# ======================================
# API & Web Configuration / إعدادات الـ API والويب
# ======================================

# FastAPI Settings
API_HOST=localhost
API_PORT=8000
API_DEBUG=false
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Integration
FRONTEND_URL=http://localhost:3000
ENABLE_SWAGGER_UI=true

# ======================================
# Logging & Monitoring / إعدادات السجلات والمراقبة
# ======================================

# Log Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_STRUCTURED_LOGGING=true

# Performance Monitoring
ENABLE_PROFILING=false
PROFILE_OUTPUT_PATH=./artifacts/profiling

# Error Tracking
ENABLE_ERROR_TRACKING=true
SENTRY_DSN=  # Optional: Add Sentry DSN for error tracking

# ======================================
# Security Settings / إعدادات الأمان
# ======================================

# API Security
API_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Data Security
ENCRYPT_SENSITIVE_DATA=true
HASH_ALGORITHM=SHA256

# ======================================
# Development Settings / إعدادات التطوير
# ======================================

# Development Mode
DEVELOPMENT_MODE=false
ENABLE_DEBUG_OUTPUTS=false

# Testing
RUN_INTEGRATION_TESTS=false
TEST_DATA_PATH=./data/test

# Documentation
ENABLE_API_DOCS=true
DOCS_PATH=./docs

# ======================================
# Regional Settings / الإعدادات الإقليمية
# ======================================

# Timezone Configuration
DEFAULT_TIMEZONE=Asia/Riyadh
ENABLE_TIMEZONE_DETECTION=true

# Currency Settings
DEFAULT_CURRENCY=SAR
ENABLE_MULTI_CURRENCY=true

# Language Settings
DEFAULT_LANGUAGE=ar
FALLBACK_LANGUAGE=en
ENABLE_BILINGUAL_REPORTS=true

# ======================================
# Business Logic / منطق الأعمال
# ======================================

# SLA Configuration
DEFAULT_SLA_DAYS=3
ENABLE_SLA_MONITORING=true

# KPI Thresholds
MIN_DELIVERY_SUCCESS_RATE=0.95
MAX_DELIVERY_TIME_HOURS=24

# Business Rules
ENABLE_BUSINESS_VALIDATION=true
STRICT_ENTITY_RESOLUTION=true

# ======================================
# Backup & Recovery / النسخ الاحتياطي والاستعادة
# ======================================

# Backup Settings
ENABLE_AUTO_BACKUP=true
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./artifacts/backups

# Recovery Settings
ENABLE_CHECKPOINT_RECOVERY=true
CHECKPOINT_INTERVAL_MINUTES=30
