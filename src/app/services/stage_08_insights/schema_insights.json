{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage 08 Official Insights",
  "type": "object",
  "required": ["run_id", "generated_at", "timezone", "summary", "insights"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "timezone": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "required": ["official_count", "exploratory_count", "n_rows"],
      "properties": {
        "official_count": { "type": "integer", "minimum": 0 },
        "exploratory_count": { "type": "integer", "minimum": 0 },
        "n_rows": { "type": ["integer", "null"], "minimum": 0 },
        "max_strength": { "type": ["number", "null"] },
        "max_confidence": { "type": ["number", "null"] },
        "median_confidence": { "type": ["number", "null"] }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "features": { "type": "string" },
        "correlations": { "type": "string" },
        "redundancy": { "type": "string" },
        "text_profile": { "type": ["string", "null"] },
        "sentiment": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kpi", "relation", "direction", "strength", "confidence", "coverage", "stability_score", "n", "evidence"],
        "properties": {
          "kpi": { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "minLength": 3 },
          "direction": { "type": "string", "enum": ["positive", "negative", "mixed", "unknown"] },
          "strength": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "coverage": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "stability_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "segment": { "type": ["string", "null"] },
          "window": { "type": ["string", "null"] },
          "n": { "type": "integer", "minimum": 0 },
          "bucket": { "type": ["string", "null"], "enum": ["HIGH", "MEDIUM", "LOW", null] },
          "notes": { "type": ["string", "null"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "nzv_impact": {
      "type": "object",
      "properties": {
        "low_variance_ignored_columns": { "type": "array" },
        "high_imbalance_included_columns": { "type": "array" },
        "nzv_summary": { "type": ["object", "null"] },
        "nzv_source": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
